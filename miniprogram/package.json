{
  "name": "literature-mp",
  "version": "1.0.0",
  "private": true,
  "description": "电力文献微信小程序（Taro 4 + React，仅面向网页端注册用户）",
  "templateInfo": {
    "name": "default",
    "typescript": false,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.1.2",
    "@tarojs/helper": "4.1.2",
    "@tarojs/plugin-framework-react": "4.1.2",
    "@tarojs/plugin-platform-weapp": "4.1.2",
    "@tarojs/react": "4.1.2",
    "@tarojs/runtime": "4.1.2",
    "@tarojs/shared": "4.1.2",
    "@tarojs/taro": "4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.1.2",
    "@tarojs/webpack5-runner": "4.1.2",
    "babel-preset-taro": "4.1.2",
    "postcss": "^8.4.38",
    "sass": "^1.75.0",
    "webpack": "^5.91.0"
  }
}
