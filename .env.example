PORT=4177
CLIENT_ORIGIN=http://127.0.0.1:5173
ADMIN_PASSPORT=
# 网页通行证（必填，无默认值；硬编码默认值曾在公开历史中泄露，2026-10-01 起强制从 .env 提供）
USER_PASSPORT=
# 普通通行证（必填，无默认值）
# 超级管理员用户名（必填，无默认值）
SUPER_ADMIN_USERNAME=
PASSPORT_TOKEN_TTL_HOURS=24
MAX_PERSONAL_ACCOUNTS=40
MAX_ACTIVE_IPS=20
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=12
USER_TOKEN_TTL_DAYS=30
# IEEE Xplore API（developer.ieee.org 申请）。访问限制：
# - 注册档约 200 次调用/天，单次最多返回 200 条记录（以注册时展示的 Rate Limits 为准）；
# - 网关不返回剩余额度响应头，因此本地按 UTC 日记账，达到上限当天不再发请求，
#   自动降级到 Scopus / Crossref / 浏览器兜底；
# - 收到 429 会把当天额度直接打满，避免继续被拒。
IEEE_ENABLED=true
IEEE_API_KEY=
# 默认 180，比官方额度留 20 次余量；0 表示不限制。
IEEE_DAILY_CALL_LIMIT=180
# 同一时刻只允许一个 IEEE 请求，且两次请求至少间隔这么久。
IEEE_REQUEST_INTERVAL_MS=1500
ELSEVIER_API_KEY=
# OpenAlex 自 2026-02 起要求所有生产请求带 API key（免费注册：openalex.org/settings/api），
# 并按日额度计费。没有 key 时每次调用都落在匿名共享池上，额度一空就是 429
# 「Insufficient budget」——采集与补全都是白跑，还会把整条链路拖慢，所以默认关闭。
# 拿到可用 key 后：OPENALEX_ENABLED=true + OPENALEX_API_KEY=<key> + PUBLIC_DATA_SOURCES 加回 openalex。
OPENALEX_ENABLED=false
OPENALEX_API_KEY=
PUBLIC_DATA_SOURCES=crossref
CROSSREF_MAILTO=
CRAWLER_ENABLED=true
CRAWLER_TIMEOUT_MS=12000
SEMANTIC_SCHOLAR_REQUEST_INTERVAL_MS=1100
# 统一浏览器兜底：DOI 类 API 与纯 HTTP 抓落地页全部失败后的最后一步。
# 固定流程见 server/web-fallback.js：按序取站 → 全局串行节流 → 真实浏览器渲染
# → 统一解析（JSON-LD / 出版社 meta / citation_*）→ 标题或 DOI 校验 → 只补缺失字段。
WEB_FALLBACK_ENABLED=true
# 站点顺序；landingPage=DOI 解析后的出版社落地页，semanticScholar=Semantic Scholar 检索页。
WEB_FALLBACK_SITES=landingPage,semanticScholar
WEB_FALLBACK_REQUEST_INTERVAL_MS=12000
WEB_FALLBACK_TIMEOUT_MS=30000
# Optional. Leave empty to auto-detect Microsoft Edge or Google Chrome.
WEB_FALLBACK_BROWSER_EXECUTABLE=
# 旧版 Semantic Scholar 网页兜底已并入上面的统一流程，保留开关只为兼容旧配置。
SEMANTIC_SCHOLAR_WEB_FALLBACK_ENABLED=false
TRANSLATION_PROVIDER=auto
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_REGION=cn-north-1
VOLCENGINE_SERVICE=translate
VOLCENGINE_TRANSLATE_ENDPOINT=https://translate.volcengineapi.com
VOLCENGINE_REQUEST_INTERVAL_MS=250
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=
BAIDU_TRANSLATE_REQUEST_INTERVAL_MS=125
REFRESH_CRON=0 8 * * *
LOOKBACK_DAYS=45
WEEKLY_DIGEST_CRON=0 8 * * 1
WEEKLY_DIGEST_DAYS=7
WEEKLY_DIGEST_LIMIT=0
WEEKLY_DIGEST_TRANSLATION_LANGUAGE=zh
WEEKLY_DIGEST_DIR=data/digests
WEEKLY_DIGEST_TRANSLATE_MISSING_LIMIT=20
WEEKLY_DIGEST_ENRICH_MISSING_LIMIT=50
WEEKLY_DIGEST_EMAIL_ENABLED=true
